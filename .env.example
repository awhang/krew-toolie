# Example environment file (do NOT commit real secrets here).
# Copy this to `.env` and fill in real values.

# Discord bot token (required).
DISCORD_TOKEN=your_discord_token_here

# Postgres password for the `postgres` user. Use a strong random value and do
# not commit the real value. docker-compose.yml references ${POSTGRES_PASSWORD}.
POSTGRES_PASSWORD=change_me_to_a_strong_random_value

# Optional: Discord server (guild) ID where slash commands should be registered.
# Setting this makes command updates (e.g. /removetool, /borrow options) appear
# immediately instead of waiting for Discord's ~1 hour global-command cache.
# If empty, the bot auto-registers to its single guild, else runs commands
# globally. Leave empty unless the bot is in multiple servers.
# Enable Developer Mode in Discord -> right-click your server -> Copy Server ID.
#GUILD_ID=
